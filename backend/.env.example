DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
DATA_UPLOAD_MAX_MEMORY_SIZE=1048576

# API abuse limits
THROTTLE_ANON_RATE=120/hour
THROTTLE_USER_RATE=1000/hour
THROTTLE_AUTH_RATE=10/minute
THROTTLE_AUTH_READ_RATE=60/minute
THROTTLE_AGENT_SEARCH_RATE=30/minute
THROTTLE_ORDER_CREATE_RATE=10/minute
THROTTLE_HEALTH_RATE=120/minute
THROTTLE_COMMERCE_CATALOG_RATE=120/minute

POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=
# Optional deployment alternative to the POSTGRES_* variables above:
DATABASE_URL=

GROQ_API_KEY=
# Hosted inference uses the Apache-2.0 open-weight GPT-OSS model. GROQ_MODEL is
# still accepted as a backwards-compatible alias.
OPEN_MODEL_NAME=openai/gpt-oss-20b
GROQ_MODEL=
CHAT_ANONYMOUS_TOKEN_TTL_SECONDS=43200

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Alert after repeated inbox processing failures; reconcile only stale pending
# orders; never initiate a refund larger than this exact INR amount.
RAZORPAY_WEBHOOK_ALERT_ATTEMPTS=3
RAZORPAY_RECONCILIATION_STALE_MINUTES=10
RAZORPAY_REFUND_MAX_AMOUNT=100000.00

# Deterministic buildathon money-action limits
MONEY_SUPPORTED_CURRENCY=INR
MONEY_MAX_ITEM_QUANTITY=5
MONEY_MAX_ORDER_VALUE=100000.00
MONEY_QUOTE_TTL_SECONDS=600
MONEY_APPROVAL_TTL_SECONDS=300
MONEY_DECISION_TOKEN_TTL_SECONDS=1800
MONEY_REQUIRE_RAZORPAY_TEST_MODE=True
ORDER_RESERVATION_TTL_SECONDS=900
ORDER_MAX_CART_ITEMS=10
GROWTH_MAX_ADDON_OFFERS=2

# Required only when running: python manage.py seed_demo_accounts
DEMO_BUYER_USERNAME=
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
DEMO_MERCHANT_USERNAME=
DEMO_MERCHANT_EMAIL=
DEMO_MERCHANT_PASSWORD=
DEMO_MERCHANT_NAME=
